rules_version = '2';
// Regras do torneio compartilhado (PLANO.md, seção 10):
// - quem entrou com o Google e tem o código lê o torneio;
// - só o organizador cria/muda/apaga a base do torneio (regras, times, sorteio);
// - mesários gravam os jogos em andamento e os resultados só do campo que travaram.
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados de quem entrou com o Google (caixa da pelada): só o dono lê e escreve
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Plano pago (PLANO.md, seção 14) ----
    // O plano (Premium, créditos de torneio) só o servidor grava; o dono só lê.
    match /planos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Liga/desliga a cobrança (muda no console do Firebase, sem versão nova do app).
    match /config/{doc} {
      allow read: if true;
    }
    // Uso da conta: o app só consegue somar 1 (numa pelada ou num torneio); não zera nem apaga.
    match /contadores/{uid} {
      function uso(d, campo) { return d.get(campo, 0); }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios') == 1
        && uso(request.resource.data, 'peladas') >= 0 && uso(request.resource.data, 'torneios') >= 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') >= uso(resource.data, 'peladas')
        && uso(request.resource.data, 'torneios') >= uso(resource.data, 'torneios')
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios')
           == uso(resource.data, 'peladas') + uso(resource.data, 'torneios') + 1;
    }
    // Peladas feitas em cada celular (qualquer conta): só soma 1; ninguém lista os celulares.
    match /aparelhos/{id} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['peladas']) && request.resource.data.peladas == 1;
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['peladas'])
        && request.resource.data.peladas == resource.data.peladas + 1;
    }

    // Campo pago da pelada (PLANO.md, seção 12): o organizador publica a cobrança; quem tem o
    // link lê e avisa "já paguei" no próprio registro; só o organizador marca "pago" (a não ser
    // que ele tenha ligado a confirmação automática). Ninguém de fora desfaz um "pago".
    match /cobrancas/{codigo} {
      // get = quem tem o código; list só as próprias (excluir a conta), ninguém lista as dos outros
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.organizador == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.organizador == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.organizador == request.auth.uid;

      match /avisos/{jogador} {
        function cobranca() { return get(/databases/$(database)/documents/cobrancas/$(codigo)).data; }
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          cobranca().organizador == request.auth.uid
          || ((resource == null || resource.data.status != 'pago')
              && (request.resource.data.status == 'avisou'
                  || (request.resource.data.status == 'pago' && cobranca().confirmarAuto == true))));
      }
    }

    // Pelada compartilhada (PLANO.md, seção 16): quem tem o link acompanha (até sem login, com a conta
    // anônima). Só quem está no controle grava (um celular por vez). Assume o controle o dono (retomando)
    // ou quem tem o link de controle: ele grava a chave em pedidos/{uid} e ela tem que bater com a do dono,
    // que fica em privado/chave (ninguém mais lê). O dono nunca muda.
    match /peladas/{codigo} {
      function caminho() { return /databases/$(database)/documents/peladas/$(codigo); }
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function chaveConfere() {
        return get(/databases/$(database)/documents/peladas/$(codigo)/pedidos/$(request.auth.uid)).data.chave
          == get(/databases/$(database)/documents/peladas/$(codigo)/privado/chave).data.valor;
      }
      // get = quem tem o código; ninguém lista as peladas
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.dono == request.auth.uid
        && request.resource.data.controlador == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.dono == resource.data.dono && (
        // quem está no controle grava o jogo (sem mexer no controle nem no nome da dona)
        (resource.data.controlador == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['app', 'encerrada', 'atualizadaEm']))
        // assumir o controle: só muda quem controla (a pelada fica igual); o dono ou quem tem a chave
        || (request.resource.data.controlador == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controlador', 'nomeDoControlador'])
            && (resource.data.dono == request.auth.uid || (comConta() && chaveConfere()))));
      allow delete: if request.auth != null && resource.data.dono == request.auth.uid;

      match /privado/{documento} {
        allow read, write: if request.auth != null && get(caminho()).data.dono == request.auth.uid;
      }
      match /pedidos/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Torneio: só quem entrou com o Google (conta anônima não lê nem marca jogos)
    match /torneios/{codigo} {
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function organizador() { return get(/databases/$(database)/documents/torneios/$(codigo)).data.nuvem.organizador; }
      function souOrganizador() { return organizador() == request.auth.uid; }
      // mesário: quem travou aquele campo
      function mesarioDo(campo) {
        return exists(/databases/$(database)/documents/torneios/$(codigo)/campos/$(string(campo)))
          && get(/databases/$(database)/documents/torneios/$(codigo)/campos/$(string(campo))).data.uid == request.auth.uid;
      }
      // get = quem tem o código; list só os próprios (excluir a conta), ninguém lista os dos outros
      allow get: if comConta();
      allow list: if comConta() && resource.data.nuvem.organizador == request.auth.uid;
      allow create: if comConta() && request.resource.data.nuvem.organizador == request.auth.uid;
      allow update, delete: if comConta() && resource.data.nuvem.organizador == request.auth.uid;

      // Campo do mesário: quem pega trava; só ele mesmo ou o organizador libera
      match /campos/{campo} {
        allow read: if comConta();
        allow create: if comConta() && request.resource.data.uid == request.auth.uid;
        allow update: if comConta() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if comConta() && (resource.data.uid == request.auth.uid || organizador() == request.auth.uid);
      }

      // Jogos em andamento: o organizador marca todos; o mesário só os do campo dele
      match /partidas/{jogo} {
        allow read: if comConta();
        allow create: if comConta() && (souOrganizador() || mesarioDo(request.resource.data.campo));
        allow update: if comConta() && (souOrganizador() || (mesarioDo(resource.data.campo) && mesarioDo(request.resource.data.campo)));
        allow delete: if comConta() && (souOrganizador() || mesarioDo(resource.data.campo));
      }
      // Resultados: o organizador ou o mesário do campo onde o jogo estava (encerrar) ou volta (reabrir)
      match /resultados/{jogo} {
        function partida() { return /databases/$(database)/documents/torneios/$(codigo)/partidas/$(jogo); }
        function jogoNoMeuCampo() {
          return (exists(partida()) && mesarioDo(get(partida()).data.campo))
            || (existsAfter(partida()) && mesarioDo(getAfter(partida()).data.campo));
        }
        allow read: if comConta();
        allow write: if comConta() && (souOrganizador() || jogoNoMeuCampo());
      }
    }
  }
}
