rules_version = '2';
// Regras do torneio compartilhado (PLANO.md, seção 10):
// - quem entrou com o Google e tem o código lê o torneio;
// - só o organizador cria/muda/apaga a base do torneio (regras, times, sorteio);
// - mesários gravam os jogos em andamento e os resultados; cada um trava o seu campo.
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados de quem entrou com o Google (caixa da pelada): só o dono lê e escreve
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Plano pago (PLANO.md, seção 14) ----
    // O plano (Premium, créditos de torneio) só o servidor grava; o dono só lê.
    match /planos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Liga/desliga a cobrança (muda no console do Firebase, sem versão nova do app).
    match /config/{doc} {
      allow read: if true;
    }
    // Uso da conta: o app só consegue somar 1 (numa pelada ou num torneio); não zera nem apaga.
    match /contadores/{uid} {
      function uso(d, campo) { return d.get(campo, 0); }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios') == 1
        && uso(request.resource.data, 'peladas') >= 0 && uso(request.resource.data, 'torneios') >= 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') >= uso(resource.data, 'peladas')
        && uso(request.resource.data, 'torneios') >= uso(resource.data, 'torneios')
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios')
           == uso(resource.data, 'peladas') + uso(resource.data, 'torneios') + 1;
    }
    // Peladas feitas em cada celular (qualquer conta): só soma 1; ninguém lista os celulares.
    match /aparelhos/{id} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['peladas']) && request.resource.data.peladas == 1;
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['peladas'])
        && request.resource.data.peladas == resource.data.peladas + 1;
    }

    // Campo pago da pelada (PLANO.md, seção 12): o organizador publica a cobrança; quem tem o
    // link lê e avisa "já paguei" no próprio registro; só o organizador marca "pago" (a não ser
    // que ele tenha ligado a confirmação automática). Ninguém de fora desfaz um "pago".
    match /cobrancas/{codigo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.organizador == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.organizador == request.auth.uid;

      match /avisos/{jogador} {
        function cobranca() { return get(/databases/$(database)/documents/cobrancas/$(codigo)).data; }
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          cobranca().organizador == request.auth.uid
          || ((resource == null || resource.data.status != 'pago')
              && (request.resource.data.status == 'avisou'
                  || (request.resource.data.status == 'pago' && cobranca().confirmarAuto == true))));
      }
    }

    // Torneio: só quem entrou com o Google (conta anônima não lê nem marca jogos)
    match /torneios/{codigo} {
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function organizador() { return get(/databases/$(database)/documents/torneios/$(codigo)).data.nuvem.organizador; }
      allow read: if comConta();
      allow create: if comConta() && request.resource.data.nuvem.organizador == request.auth.uid;
      allow update, delete: if comConta() && resource.data.nuvem.organizador == request.auth.uid;

      // Campo do mesário: quem pega trava; só ele mesmo ou o organizador libera
      match /campos/{campo} {
        allow read: if comConta();
        allow create: if comConta() && request.resource.data.uid == request.auth.uid;
        allow update: if comConta() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if comConta() && (resource.data.uid == request.auth.uid || organizador() == request.auth.uid);
      }

      match /{parte}/{jogo} {
        allow read: if comConta();
        allow write: if comConta() && parte in ['partidas', 'resultados'];
      }
    }
  }
}
