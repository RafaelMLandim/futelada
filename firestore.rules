rules_version = '2';
// Regras do torneio compartilhado (PLANO.md, seção 10):
// - quem entrou com o Google e tem o código lê o torneio;
// - só o organizador cria/muda/apaga a base do torneio (regras, times, sorteio);
// - mesários gravam os jogos em andamento e os resultados só do campo que travaram.
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados de quem entrou com o Google (caixa da pelada): só o dono lê e escreve
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Conta do jogador (PLANO.md, seção 17) ----
    // Foto e apelido: quem tem a conta da pessoa na pelada vê (a foto sai na imagem da seleção); só o dono troca.
    // get, nunca list: ninguém percorre os perfis. A imagem é pequena e fica no próprio documento.
    match /perfis/{uid} {
      allow get: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['foto', 'apelido', 'atualizadaEm', 'fotoRemovida'])
        // fotoRemovida: só o servidor marca (denúncias); o dono só mantém ou apaga ao trocar a foto
        && (!('fotoRemovida' in request.resource.data) || (resource != null && request.resource.data.fotoRemovida == resource.data.get('fotoRemovida', null)))
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() < 100000))
        && (!('apelido' in request.resource.data) || (request.resource.data.apelido is string && request.resource.data.apelido.size() > 0 && request.resource.data.apelido.size() <= 20));
    }
    // Denúncias de foto ou apelido: só o servidor grava e lê (função denunciarFoto).
    match /denuncias/{id} {
      allow read, write: if false;
    }
    // A carta: só o servidor grava; o dono só lê (o jogador não edita os próprios números).
    match /cartas/{uid}/peladas/{pelada} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Os torneios na carta (seção 22.2): também só o servidor grava; o dono só lê.
    match /cartas/{uid}/torneios/{torneio} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Link da pelada (seção 17.2): quem tem o código vê a lista e se coloca nela, sempre no próprio registro;
    // o organizador tira quem foi para a fila. Ninguém de fora mexe no registro dos outros.
    match /listas/{codigo} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.organizador == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.organizador == request.auth.uid
        && request.resource.data.keys().hasOnly(['organizador', 'data']);
      allow update, delete: if request.auth != null && resource.data.organizador == request.auth.uid;

      match /confirmados/{id} {
        function organizador() { return get(/databases/$(database)/documents/listas/$(codigo)).data.organizador; }
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == id
          && exists(/databases/$(database)/documents/listas/$(codigo))
          && request.resource.data.keys().hasOnly(['nome', 'comConta', 'em', 'goleiro'])
          && (!('goleiro' in request.resource.data) || request.resource.data.goleiro == true)
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 40
          && request.resource.data.comConta is bool && request.resource.data.em is number;
        // o organizador só marca que a pessoa já está na fila (ou a volta para os confirmados, se foi engano)
        allow update: if request.auth != null && request.auth.uid == organizador()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['naFila'])
          && request.resource.data.naFila is bool;
        allow delete: if request.auth != null && (request.auth.uid == id || request.auth.uid == organizador());
      }
    }

    // Inscrição dos times pelo link (seção 22): quem tem o código vê os times inscritos. O capitão (com conta)
    // inscreve o time; os jogadores entram pelo link do time, cada um no próprio registro (com conta ou só o nome).
    // Com as inscrições fechadas (sorteio feito), ninguém entra mais. Só o organizador muda o link.
    match /inscricoes/{codigo} {
      function link() { return get(/databases/$(database)/documents/inscricoes/$(codigo)).data; }
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.organizador == request.auth.uid;
      allow create: if comConta() && request.resource.data.organizador == request.auth.uid
        && request.resource.data.keys().hasOnly(['organizador', 'nomeDoTorneio', 'aberta', 'limiteDeTimes', 'torneio']);
      allow update: if comConta() && resource.data.organizador == request.auth.uid && request.resource.data.organizador == request.auth.uid
        && request.resource.data.keys().hasOnly(['organizador', 'nomeDoTorneio', 'aberta', 'limiteDeTimes', 'torneio']);
      allow delete: if comConta() && resource.data.organizador == request.auth.uid;

      match /times/{time} {
        function nomeECor(dados) {
          return dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 30
            && dados.cor is string && dados.cor.size() <= 9;
        }
        allow read: if request.auth != null;
        allow create: if comConta() && link().aberta == true
          && request.resource.data.capitao == request.auth.uid
          && request.resource.data.keys().hasOnly(['capitao', 'nomeDoCapitao', 'nome', 'cor', 'em'])
          && nomeECor(request.resource.data) && request.resource.data.em is number
          && request.resource.data.nomeDoCapitao is string && request.resource.data.nomeDoCapitao.size() <= 40;
        // o capitão (com as inscrições abertas) ou o organizador mudam só o nome e a cor
        allow update: if request.auth != null
          && (request.auth.uid == link().organizador || (request.auth.uid == resource.data.capitao && link().aberta == true))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'cor'])
          && nomeECor(request.resource.data);
        allow delete: if request.auth != null && (request.auth.uid == resource.data.capitao || request.auth.uid == link().organizador);

        match /jogadores/{id} {
          function timeInscrito() { return get(/databases/$(database)/documents/inscricoes/$(codigo)/times/$(time)).data; }
          allow read: if request.auth != null;
          allow create, update: if request.auth != null && request.auth.uid == id && link().aberta == true
            && exists(/databases/$(database)/documents/inscricoes/$(codigo)/times/$(time))
            && request.resource.data.keys().hasOnly(['nome', 'comConta', 'em', 'goleiro', 'camisa'])
            && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 40
            && request.resource.data.comConta is bool && request.resource.data.em is number
            // "com conta" só quem entrou mesmo com a conta
            && (request.resource.data.comConta == false || comConta())
            && (!('goleiro' in request.resource.data) || request.resource.data.goleiro is bool)
            && (!('camisa' in request.resource.data) || (request.resource.data.camisa is int && request.resource.data.camisa >= 0 && request.resource.data.camisa <= 99));
          allow delete: if request.auth != null
            && (request.auth.uid == id || request.auth.uid == timeInscrito().capitao || request.auth.uid == link().organizador);
        }
      }
    }

    // ---- Plano pago (PLANO.md, seção 14) ----
    // O plano (Premium, créditos de torneio) só o servidor grava; o dono só lê.
    match /planos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // Liga/desliga a cobrança (muda no console do Firebase, sem versão nova do app).
    match /config/{doc} {
      allow read: if true;
    }
    // Uso da conta: o app só consegue somar 1 (numa pelada ou num torneio); não zera nem apaga.
    match /contadores/{uid} {
      function uso(d, campo) { return d.get(campo, 0); }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios') == 1
        && uso(request.resource.data, 'peladas') >= 0 && uso(request.resource.data, 'torneios') >= 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['peladas', 'torneios'])
        && uso(request.resource.data, 'peladas') >= uso(resource.data, 'peladas')
        && uso(request.resource.data, 'torneios') >= uso(resource.data, 'torneios')
        && uso(request.resource.data, 'peladas') + uso(request.resource.data, 'torneios')
           == uso(resource.data, 'peladas') + uso(resource.data, 'torneios') + 1;
    }
    // Peladas feitas em cada celular (qualquer conta): só soma 1; ninguém lista os celulares.
    match /aparelhos/{id} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['peladas']) && request.resource.data.peladas == 1;
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['peladas'])
        && request.resource.data.peladas == resource.data.peladas + 1;
    }

    // Campo pago da pelada (PLANO.md, seção 12): o organizador publica a cobrança; quem tem o
    // link lê e avisa "já paguei" no próprio registro; só o organizador marca "pago" (a não ser
    // que ele tenha ligado a confirmação automática). Ninguém de fora desfaz um "pago".
    match /cobrancas/{codigo} {
      // get = quem tem o código; list só as próprias (excluir a conta), ninguém lista as dos outros
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.organizador == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.organizador == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.organizador == request.auth.uid;

      match /avisos/{jogador} {
        function cobranca() { return get(/databases/$(database)/documents/cobrancas/$(codigo)).data; }
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          cobranca().organizador == request.auth.uid
          || ((resource == null || resource.data.status != 'pago')
              && (request.resource.data.status == 'avisou'
                  || (request.resource.data.status == 'pago' && cobranca().confirmarAuto == true))));
      }
    }

    // Pelada compartilhada (PLANO.md, seção 16): quem tem o link acompanha (até sem login, com a conta
    // anônima). Só quem está no controle grava (um celular por vez). Assume o controle o dono (retomando)
    // ou quem tem o link de controle: ele grava a chave em pedidos/{uid} e ela tem que bater com a do dono,
    // que fica em privado/chave (ninguém mais lê). O dono nunca muda.
    match /peladas/{codigo} {
      function caminho() { return /databases/$(database)/documents/peladas/$(codigo); }
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function chaveConfere() {
        return get(/databases/$(database)/documents/peladas/$(codigo)/pedidos/$(request.auth.uid)).data.chave
          == get(/databases/$(database)/documents/peladas/$(codigo)/privado/chave).data.valor;
      }
      // get = quem tem o código; ninguém lista as peladas
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.dono == request.auth.uid
        && request.resource.data.controlador == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.dono == resource.data.dono && (
        // quem está no controle grava o jogo (sem mexer no controle nem no nome da dona)
        (resource.data.controlador == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['app', 'encerrada', 'atualizadaEm']))
        // assumir o controle: só muda quem controla (a pelada fica igual); o dono ou quem tem a chave
        || (request.resource.data.controlador == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controlador', 'nomeDoControlador'])
            && (resource.data.dono == request.auth.uid || (comConta() && chaveConfere()))));
      allow delete: if request.auth != null && resource.data.dono == request.auth.uid;

      match /privado/{documento} {
        allow read, write: if request.auth != null && get(caminho()).data.dono == request.auth.uid;
      }
      match /pedidos/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Torneio: só quem entrou com o Google (conta anônima não lê nem marca jogos)
    match /torneios/{codigo} {
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      // getAfter: vale também quando o torneio é criado no mesmo envio que os jogos em andamento
      // (compartilhar um torneio que já começou)
      function organizador() { return getAfter(/databases/$(database)/documents/torneios/$(codigo)).data.nuvem.organizador; }
      function souOrganizador() { return organizador() == request.auth.uid; }
      // mesário: quem travou aquele campo
      function mesarioDo(campo) {
        return exists(/databases/$(database)/documents/torneios/$(codigo)/campos/$(string(campo)))
          && get(/databases/$(database)/documents/torneios/$(codigo)/campos/$(string(campo))).data.uid == request.auth.uid;
      }
      // telão (TV, sem conta): lê o torneio que a organizadora pareou com aquela tela (só ler, nunca gravar)
      function telaDoTorneio() {
        return request.auth != null
          && exists(/databases/$(database)/documents/telas/$(request.auth.uid))
          && get(/databases/$(database)/documents/telas/$(request.auth.uid)).data.get('torneio', '') == codigo;
      }
      // get = quem tem o código; list só os próprios (excluir a conta), ninguém lista os dos outros
      allow get: if comConta() || telaDoTorneio();
      allow list: if comConta() && resource.data.nuvem.organizador == request.auth.uid;
      allow create: if comConta() && request.resource.data.nuvem.organizador == request.auth.uid;
      allow update, delete: if comConta() && resource.data.nuvem.organizador == request.auth.uid;

      // Campo do mesário: quem pega trava; só ele mesmo ou o organizador libera
      match /campos/{campo} {
        allow read: if comConta();
        allow create: if comConta() && request.resource.data.uid == request.auth.uid;
        allow update: if comConta() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if comConta() && (resource.data.uid == request.auth.uid || organizador() == request.auth.uid);
      }

      // "Esse sou eu" (seção 22.4): quem tem conta pede para ser um jogador digitado, sempre no próprio pedido;
      // o organizador vê os pedidos e tira (confirmado ou recusado). Ninguém mais lê.
      match /pedidos/{conta} {
        allow get: if comConta() && (request.auth.uid == conta || souOrganizador());
        allow list: if comConta() && souOrganizador();
        allow create, update: if comConta() && request.auth.uid == conta
          && request.resource.data.keys().hasOnly(['jogador', 'nomeDoJogador', 'nomeDaConta', 'em'])
          && request.resource.data.jogador is string && request.resource.data.nomeDoJogador is string
          && request.resource.data.nomeDaConta is string && request.resource.data.nomeDaConta.size() <= 40 && request.resource.data.em is number;
        allow delete: if comConta() && (request.auth.uid == conta || souOrganizador());
      }

      // Jogos em andamento: o organizador marca todos; o mesário só os do campo dele
      match /partidas/{jogo} {
        allow read: if comConta() || telaDoTorneio();
        allow create: if comConta() && (souOrganizador() || mesarioDo(request.resource.data.campo));
        allow update: if comConta() && (souOrganizador() || (mesarioDo(resource.data.campo) && mesarioDo(request.resource.data.campo)));
        allow delete: if comConta() && (souOrganizador() || mesarioDo(resource.data.campo));
      }
      // Resultados: o mesário só cria o resultado ao encerrar o jogo que está no campo dele (o jogo em andamento
      // existia antes de encerrar). Mudar ou apagar um resultado (corrigir depois) é só do organizador.
      match /resultados/{jogo} {
        function partida() { return /databases/$(database)/documents/torneios/$(codigo)/partidas/$(jogo); }
        function jogoNoMeuCampo() { return exists(partida()) && mesarioDo(get(partida()).data.campo); }
        allow read: if comConta() || telaDoTorneio();
        allow create: if comConta() && (souOrganizador() || jogoNoMeuCampo());
        allow update, delete: if comConta() && souOrganizador();
      }
    }

    // Telão (PLANO.md, seção 20): a TV entra anônima e cria a tela dela (id = uid) com um código; a organizadora
    // digita o código no celular e grava qual torneio e qual campo a tela mostra. Só a organizadora daquele
    // torneio pareia; a tela só troca o próprio código (o que desfaz o pareamento).
    match /telas/{uid} {
      function comConta() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function organizadoraDoTorneio(codigo) {
        return get(/databases/$(database)/documents/torneios/$(codigo)).data.nuvem.organizador == request.auth.uid;
      }
      allow get: if request.auth != null && (request.auth.uid == uid || comConta());
      // achar a tela pelo código (uma por vez)
      allow list: if comConta() && request.query.limit <= 1;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo', 'criadaEm']) && request.resource.data.codigo is string;
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.keys().hasOnly(['codigo', 'criadaEm']) && request.resource.data.codigo is string)
        || (comConta()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['torneio', 'campo', 'nomeDoTorneio', 'pareadaEm'])
            && request.resource.data.campo is int && request.resource.data.campo >= 1
            && organizadoraDoTorneio(request.resource.data.torneio)));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
